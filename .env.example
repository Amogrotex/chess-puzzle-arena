# ---------------------------------------------------------------------------
# Puzzle Arena — server configuration (copy to .env and adjust)
# ---------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# CHANGE THIS in production: any long random string
JWT_SECRET=puzzle-arena-dev-secret-change-me-in-production
JWT_EXPIRES_IN=30d

# SQLite file (created automatically)
DB_FILE=./data/app.db

# Puzzle dataset (generated by scripts/build-puzzles.py)
# PUZZLES_FILE=./data/puzzles.json

# Where the built React app lives (server serves it in production)
# CLIENT_DIST=./client/dist
